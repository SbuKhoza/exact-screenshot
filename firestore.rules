rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function activeTenant(id) { return id is string && get(/databases/$(database)/documents/tenants/$(id)).data.isActive != false; }
    function isTenantAdmin(id) {
      return signedIn() && request.auth.token.email_verified == true && id is string
        && activeTenant(id)
        && request.auth.token.email.lower() == get(/databases/$(database)/documents/tenants/$(id)).data.email.lower();
    }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isParent() { return signedIn() && userDoc().role == 'parent'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function str(v, max) { return v is string && v.size() <= max; }
    function learnerOk(d) {
      return str(d.firstName, 60) && d.firstName.size() > 0 && str(d.surname, 60) && d.surname.size() > 0
        && str(d.dateOfBirth, 10) && d.subjects is list && d.subjects.size() > 0
        && str(d.grade, 40) && str(d.schoolName, 120) && d.schoolName.size() > 0
        && str(d.cellphoneNumber, 20) && str(d.otherSubject, 80);
    }
    function learnerKeys() { return ['firstName','surname','dateOfBirth','cellphoneNumber','subjects','otherSubject','grade','schoolName','updatedAt','changeRequest']; }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin() || isTenantAdmin(resource.data.tenantId);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['parent', 'student']
        && request.resource.data.profileCompleted == false
        && request.resource.data.email == request.auth.token.email;
      // role can never be changed by the user
      allow update: if signedIn() && request.auth.uid == uid && onlyChanges(['profileCompleted', 'updatedAt']);
      allow delete: if false;
    }

    match /parents/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && isParent()
        && request.resource.data.uid == uid
        && str(request.resource.data.firstName, 60) && str(request.resource.data.surname, 60)
        && str(request.resource.data.cellphoneNumber, 20);
      allow delete: if false;
    }

    match /students/{id} {
      allow read: if isTenantAdmin(resource.data.tenantId) || (signedIn() && (resource.data.parentUid == request.auth.uid || resource.data.uid == request.auth.uid));
      // parent registering a child
      allow create: if isParent() && request.resource.data.parentUid == request.auth.uid
          && activeTenant(request.resource.data.tenantId) && request.resource.data.tenantId == userDoc().tenantId
          && request.resource.data.accountType == 'parent_registered' && request.resource.data.uid == null
          && request.resource.data.registrationStatus == 'pending_review' && learnerOk(request.resource.data)
        // independent student creating own record (doc id = uid)
        || (signedIn() && id == request.auth.uid && userDoc().role == 'student'
          && activeTenant(request.resource.data.tenantId) && request.resource.data.tenantId == userDoc().tenantId
          && request.resource.data.uid == request.auth.uid && request.resource.data.parentUid == null
          && request.resource.data.accountType == 'independent'
          && request.resource.data.registrationStatus == 'pending_review' && learnerOk(request.resource.data));
      allow update: if (isTenantAdmin(resource.data.tenantId)
        && onlyChanges(['registrationStatus', 'updatedAt'])
        && request.resource.data.registrationStatus in ['pending_review', 'contacted', 'enrolled', 'declined']) || (signedIn()
        && (resource.data.parentUid == request.auth.uid || resource.data.uid == request.auth.uid)
        && onlyChanges(learnerKeys()) && learnerOk(request.resource.data));
      allow delete: if false;
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Multi-tenant domain detection (read-only to everyone; managed from the admin site)
    match /domains/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /subdomains/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tenants/{id} {
      allow read: if true;
      allow write: if false;
      match /data/{docId} {
        allow read: if docId in ['contactPage', 'footer', 'homepage', 'brand'];
        allow write: if isAdmin() || (docId == 'brand' && isTenantAdmin(id)
          && request.resource.data.keys().hasOnly(['logoText', 'socialLinks', 'updatedAt'])
          && request.resource.data.logoText is string
          && request.resource.data.logoText.size() > 0
          && request.resource.data.logoText.size() <= 60
          && request.resource.data.socialLinks is map
          && request.resource.data.socialLinks.keys().hasOnly(['facebook', 'instagram', 'youtube', 'linkedin', 'tiktok'])
          && request.resource.data.socialLinks.keys().hasAll(['facebook', 'instagram', 'youtube', 'linkedin', 'tiktok'])
          && request.resource.data.socialLinks.facebook is string
          && request.resource.data.socialLinks.facebook.size() <= 500
          && (request.resource.data.socialLinks.facebook == '' || request.resource.data.socialLinks.facebook.matches('https://.*'))
          && request.resource.data.socialLinks.instagram is string
          && request.resource.data.socialLinks.instagram.size() <= 500
          && (request.resource.data.socialLinks.instagram == '' || request.resource.data.socialLinks.instagram.matches('https://.*'))
          && request.resource.data.socialLinks.youtube is string
          && request.resource.data.socialLinks.youtube.size() <= 500
          && (request.resource.data.socialLinks.youtube == '' || request.resource.data.socialLinks.youtube.matches('https://.*'))
          && request.resource.data.socialLinks.linkedin is string
          && request.resource.data.socialLinks.linkedin.size() <= 500
          && (request.resource.data.socialLinks.linkedin == '' || request.resource.data.socialLinks.linkedin.matches('https://.*'))
          && request.resource.data.socialLinks.tiktok is string
          && request.resource.data.socialLinks.tiktok.size() <= 500
          && (request.resource.data.socialLinks.tiktok == '' || request.resource.data.socialLinks.tiktok.matches('https://.*')));
      }
      match /adminProfiles/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isTenantAdmin(id);
        allow create, update: if signedIn() && request.auth.uid == uid && isTenantAdmin(id)
          && request.resource.data.keys().hasOnly(['displayName', 'cellphoneNumber', 'updatedAt'])
          && str(request.resource.data.displayName, 60) && request.resource.data.displayName.size() > 0
          && str(request.resource.data.cellphoneNumber, 20);
        allow delete: if false;
      }
    }

    match /contactMessages/{id} {
      allow create: if str(request.resource.data.name, 100) && request.resource.data.name.size() > 0
        && activeTenant(request.resource.data.tenantId)
        && str(request.resource.data.email, 255) && request.resource.data.email.matches('.+@.+\\..+')
        && str(request.resource.data.subject, 120) && str(request.resource.data.message, 1000)
        && request.resource.data.message.size() > 0 && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['tenantId','name','email','subject','message','status','createdAt']);
      allow read: if isTenantAdmin(resource.data.tenantId);
      allow update: if isTenantAdmin(resource.data.tenantId) && onlyChanges(['status'])
        && request.resource.data.status in ['new', 'read', 'resolved'];
      allow delete: if false;
    }

    match /lessonRegisters/{id} {
      allow read: if isTenantAdmin(resource.data.tenantId);
      allow create: if isTenantAdmin(request.resource.data.tenantId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['tenantId','createdBy','startDate','meetingUrl','lessons','learnerIds','createdAt'])
        && str(request.resource.data.startDate, 10)
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(request.resource.data.meetingUrl, 500)
        && (request.resource.data.meetingUrl == '' || request.resource.data.meetingUrl.matches('https://.*'))
        && request.resource.data.lessons is list && request.resource.data.lessons.size() > 0
        && request.resource.data.lessons.size() <= 12
        && request.resource.data.learnerIds is list && request.resource.data.learnerIds.size() > 0
        && request.resource.data.learnerIds.size() <= 450
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /lessonRegisterEntries/{entryId} {
      function entryOwner() {
        return signedIn() && (resource.data.learnerUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
      }
      allow read: if isTenantAdmin(resource.data.tenantId) || entryOwner();
      allow create: if isTenantAdmin(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['tenantId','groupId','learnerId','learnerUid','parentUid','learnerName','startDate','meetingUrl','lessons','lessonIds','createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.groupId is string
        && existsAfter(/databases/$(database)/documents/lessonRegisters/$(request.resource.data.groupId))
        && getAfter(/databases/$(database)/documents/lessonRegisters/$(request.resource.data.groupId)).data.tenantId == request.resource.data.tenantId
        && getAfter(/databases/$(database)/documents/lessonRegisters/$(request.resource.data.groupId)).data.learnerIds.hasAny([request.resource.data.learnerId])
        && getAfter(/databases/$(database)/documents/lessonRegisters/$(request.resource.data.groupId)).data.startDate == request.resource.data.startDate
        && getAfter(/databases/$(database)/documents/lessonRegisters/$(request.resource.data.groupId)).data.meetingUrl == request.resource.data.meetingUrl
        && getAfter(/databases/$(database)/documents/lessonRegisters/$(request.resource.data.groupId)).data.lessons == request.resource.data.lessons
        && request.resource.data.learnerId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.learnerId))
        && get(/databases/$(database)/documents/students/$(request.resource.data.learnerId)).data.tenantId == request.resource.data.tenantId
        && get(/databases/$(database)/documents/students/$(request.resource.data.learnerId)).data.registrationStatus == 'enrolled'
        && get(/databases/$(database)/documents/students/$(request.resource.data.learnerId)).data.uid == request.resource.data.learnerUid
        && get(/databases/$(database)/documents/students/$(request.resource.data.learnerId)).data.parentUid == request.resource.data.parentUid
        && request.resource.data.learnerName is string && request.resource.data.learnerName.size() > 0
        && request.resource.data.startDate is string
        && request.resource.data.meetingUrl is string
        && request.resource.data.lessons is list && request.resource.data.lessons.size() > 0
        && request.resource.data.lessons.size() <= 12
        && request.resource.data.lessonIds is list
        && request.resource.data.lessonIds.size() == request.resource.data.lessons.size();
      allow update, delete: if false;

      match /marks/{lessonId} {
        function canReadEntryMarks() {
          let entry = get(/databases/$(database)/documents/lessonRegisterEntries/$(entryId)).data;
          return isTenantAdmin(entry.tenantId) || (signedIn() && (entry.learnerUid == request.auth.uid || entry.parentUid == request.auth.uid));
        }
        allow read: if canReadEntryMarks();
        allow create, update: if isTenantAdmin(get(/databases/$(database)/documents/lessonRegisterEntries/$(entryId)).data.tenantId)
          && lessonId in get(/databases/$(database)/documents/lessonRegisterEntries/$(entryId)).data.lessonIds
          && request.resource.data.keys().hasOnly(['mark','updatedAt'])
          && request.resource.data.mark is int
          && request.resource.data.mark >= 0 && request.resource.data.mark <= 100
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
